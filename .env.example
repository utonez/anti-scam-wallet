# Copy to .env and fill in. Never commit .env.
# All values are for Base Sepolia TESTNET ONLY. Use fresh demo wallets, never a wallet holding real funds.

# --- Chain ---
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# --- Demo wallets (testnet only) ---
# Owner = the protected user; Guardian = family member who approves.
OWNER_PRIVATE_KEY=
GUARDIAN_ADDRESS=
GUARDIAN_PRIVATE_KEY=

# --- Deployed contracts (filled after deploy) ---
GUARDED_ACCOUNT_ADDRESS=
TEST_TOKEN_ADDRESS=
MOCK_SCAM_ADDRESS=

# --- LLM (server-side only, never exposed to the browser) ---
GEMINI_API_KEY=
GEMINI_MODEL=
